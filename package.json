{
  "name": "platinum-wheels",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && eslint .",
    "typecheck": "tsc --noEmit",
    "design": "npx --yes serve design -l 4000",
    "assets": "node scripts/prepare-assets.mjs",
    "vehicles:fetch": "node scripts/vehicles-fetch.mjs",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:build-csv": "tsx scripts/catalog-csv-build.ts",
    "catalog:photos": "tsx scripts/catalog-photos.ts",
    "catalog:photo-replace": "tsx scripts/catalog-photo-replace.ts",
    "catalog:photo-add": "tsx scripts/catalog-photo-add.ts",
    "test:e2e": "playwright test",
    "test:e2e:fixture": "node tests/fixture/run.mjs",
    "test:e2e:fixture:up": "node tests/fixture/run.mjs up",
    "test:e2e:fixture:down": "node tests/fixture/run.mjs down",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@vercel/functions": "3.9.9",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0-canary.37",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "undici": "8.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0-canary.37",
    "exceljs": "4.4.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
